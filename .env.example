# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Model access (OpenCode Zen / Go) ─────────────────────────────
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# Model ids under test — confirm from your dashboard.
# Suggested: two paid + one free, so the cost column has contrast.
MODELS=

# ── Hedera testnet (x402 payments + HCS receipts) ────────────────
# Two accounts, deliberately: the agent pays, the gateway operator receives.
# A transfer to yourself nets to zero and Hedera rejects it.
HEDERA_ACCOUNT_ID=0.0.10389769      # payer — the agent. Funded from the faucet
HEDERA_PRIVATE_KEY=                 # ECDSA key of the payer
HEDERA_NETWORK=hedera:testnet
HEDERA_PAY_TO=0.0.10375344          # payee — the gateway operator
HEDERA_ASSET=0.0.0                  # HBAR. Switch to the HTS USDC token id later
HCS_TOPIC_ID=

# Blocky402 facilitator — testnet is open access, no API key
BLOCKY402_BASE_URL=https://api.testnet.blocky402.com
# Do NOT hardcode the fee payer: read it from GET /supported at runtime.

# ── Base Sepolia (RunRegistry + subgraph) ────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_PRIVATE_KEY=
RUN_REGISTRY_ADDRESS=

# ── The Graph ────────────────────────────────────────────────────
SUBGRAPH_STUDIO_API_KEY=
SUBGRAPH_QUERY_URL=

# ── Budget guard ─────────────────────────────────────────────────
# Hard ceiling for the whole measured batch, in USD at list price.
# Go plan caps are ~$12/5h, $30/week — stop well before them.
BUDGET_USD_MAX=3.00

# ── Alternative model providers (GATE 0: OpenCode's API is blocked) ───────
# Both are OpenAI-compatible, so the harness needs no code change — only a key
# and prices transcribed into harness/src/prices.json.
# Open-weight only, to keep the positioning in RUNBOOK §"Model source".
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── The Graph (R7) ────────────────────────────────────────────────────────
# RunRegistry lives on Base Sepolia because The Graph cannot index Hedera and
# HCS is not EVM. The row is a POINTER to the HCS receipt, never a copy.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# A funded Base Sepolia key. Faucet: https://www.alchemy.com/faucets/base-sepolia
BASE_SEPOLIA_PRIVATE_KEY=
# Printed by ./scripts/deploy-registry.sh
RUN_REGISTRY_ADDRESS=
# ⚠️ The address that WROTE the rows. Anyone may write to the registry, so the
# allocator reads only rows from this recorder -- without the filter a stranger
# steers our spending by writing attractive fake rows.
REGISTRY_RECORDER_ADDRESS=
# Subgraph Studio: the query URL of the published subgraph
SUBGRAPH_QUERY_URL=
SUBGRAPH_STUDIO_API_KEY=
# ⚠️ The models the allocator may choose from -- what `npm run access` reports
# as reachable, not everything in the price table. Comma-separated.
WHETSTONE_CANDIDATES=groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b,groq/qwen/qwen3.6-27b
